---
import { getCollection, render } from "astro:content";
import Zaklad from "../../layouts/Zaklad.astro";
import Sekce from "../../components/Sekce.astro";
import Foto from "../../components/Foto.astro";
import VyzvaKAkci from "../../components/VyzvaKAkci.astro";
import { kategorie, href } from "../../lib/site";

export async function getStaticPaths() {
  const vsechny = await getCollection("produkty");
  return vsechny.map((p) => ({
    params: { slug: p.id },
    props: {
      produkt: p,
      pribuzne: vsechny
        .filter((x) => x.data.kategorie === p.data.kategorie && x.id !== p.id)
        .slice(0, 3),
    },
  }));
}

const { produkt, pribuzne } = Astro.props;
const d = produkt.data;
const kat = kategorie.find((k) => k.slug === d.kategorie)!;
const { Content } = await render(produkt);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: d.nazev,
  description: d.kratky,
  category: kat.nazev,
  ...(d.cenaOd
    ? {
        offers: {
          "@type": "Offer",
          priceCurrency: "CZK",
          price: d.cenaOd,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

<Zaklad titulek={d.nazev} popis={d.kratky}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="obal pt-8 text-sm text-inkoust/60">
    <a href={href("/produkty")} class="hover:text-policie-700">Produkty</a>
    <span class="mx-2">/</span>
    <a href={href(`/produkty/${kat.slug}`)} class="hover:text-policie-700">{kat.nazev}</a>
  </div>

  <Sekce trida="!pt-8">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="chraneno">
        <Foto popis={d.fotoPopis} pomer="4/3" />
        <p class="mt-3 text-xs text-inkoust/50">
          Ukázky produktů jsou chráněné autorským právem. Na webu je zobrazujeme ve zhoršené kvalitě.
        </p>
      </div>

      <div>
        {d.novinka && <span class="stitek">Novinka</span>}
        <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">{d.nazev}</h1>
        <p class="mt-4 text-lg text-inkoust/80">{d.kratky}</p>

        <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 rounded-[var(--radius-karta)] bg-papir p-5 text-sm">
          <dt class="text-inkoust/55">Cena od</dt>
          <dd class="font-nadpis font-bold">
            {d.cenaOd ? `${d.cenaOd} Kč / ${d.jednotka}` : "podle zadání"}
          </dd>
          {d.minMnozstvi && (<><dt class="text-inkoust/55">Minimální množství</dt><dd class="font-bold">{d.minMnozstvi} {d.jednotka}</dd></>)}
          {d.vzorekCena && (<><dt class="text-inkoust/55">Cena vzorku</dt><dd class="font-bold">{d.vzorekCena} Kč <span class="font-normal text-inkoust/55">(odečteme od objednávky)</span></dd></>)}
        </dl>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={href(`/poptavka?produkt=${encodeURIComponent(d.nazev)}`)} class="btn btn-hlavni">
            Poptat tento produkt
          </a>
          <a href={href("/jak-to-funguje")} class="btn btn-obrys">Jak probíhá objednávka</a>
        </div>

        {d.prednosti.length > 0 && (
          <div class="mt-8">
            <h2 class="font-nadpis text-sm font-bold uppercase tracking-wider text-policie-700">Proč ho mít</h2>
            <ul class="mt-3 space-y-2">
              {d.prednosti.map((p) => (
                <li class="flex gap-2 text-sm text-inkoust/85">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-hasici-500"></span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.varianty.length > 0 && (
          <div class="mt-6">
            <h2 class="font-nadpis text-sm font-bold uppercase tracking-wider text-policie-700">Varianty</h2>
            <ul class="mt-3 space-y-1 text-sm text-inkoust/85">
              {d.varianty.map((v) => <li>· {v}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>

    <div class="prose-web mt-14 max-w-2xl">
      <Content />
    </div>
  </Sekce>

  {pribuzne.length > 0 && (
    <Sekce pozadi="papir" nadpis={`Další z kategorie ${kat.nazev}`}>
      <div class="grid gap-6 sm:grid-cols-3">
        {pribuzne.map((p) => (
          <a
            href={href(`/produkt/${p.id}`)}
            class="group flex flex-col overflow-hidden rounded-[var(--radius-karta)] bg-white ring-1 ring-policie-100 transition-transform hover:-translate-y-1 hover:shadow-lg"
          >
            <Foto popis={p.data.fotoPopis} pomer="4/3" trida="!rounded-none !border-0" />
            <div class="p-4">
              <h3 class="text-sm font-bold text-policie-800 group-hover:text-hasici-600">{p.data.nazev}</h3>
            </div>
          </a>
        ))}
      </div>
    </Sekce>
  )}

  <VyzvaKAkci />
</Zaklad>
