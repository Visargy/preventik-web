---
interface Props {
  stitek?: string;
  nadpis: string;
  uvod?: string;
}
const { stitek, nadpis, uvod } = Astro.props;
---
<section class="border-b border-policie-100 bg-papir">
  <div class="obal py-14 md:py-20">
    {stitek && <span class="stitek">{stitek}</span>}
    <h1 class="mt-2 max-w-3xl text-4xl font-extrabold md:text-5xl">{nadpis}</h1>
    {uvod && <p class="mt-5 max-w-2xl text-lg text-inkoust/80">{uvod}</p>}
  </div>
</section>
