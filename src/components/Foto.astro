---
/**
 * Placeholder fotky pro fázi 1 (fiktivní web).
 * Vykreslí popsané pole místo skutečné fotografie, aby klient viděl,
 * jaká fotka na dané místo patří. Ve fázi 2 se nahradí <img>.
 */
interface Props {
  popis: string;
  pomer?: string; // např. "16/9", "4/3", "1/1"
  tmave?: boolean;
  trida?: string;
}
const { popis, pomer = "16/9", tmave = false, trida = "" } = Astro.props;
---
<figure
  class:list={[
    "relative overflow-hidden rounded-[var(--radius-karta)] border",
    tmave
      ? "border-policie-800 bg-policie-800 text-policie-100"
      : "border-policie-100 bg-policie-50 text-policie-700",
    trida,
  ]}
  style={`aspect-ratio:${pomer}`}
  aria-label={`Placeholder fotka: ${popis}`}
>
  <div
    class="absolute inset-0"
    style="background-image:linear-gradient(135deg, rgba(31,79,156,0.10) 0%, rgba(211,18,42,0.10) 100%);"
  >
  </div>
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-6 text-center">
    <span class="font-nadpis text-[0.7rem] font-bold uppercase tracking-[0.14em] opacity-70">
      Sem patří fotka
    </span>
    <span class="max-w-[24rem] text-sm font-medium leading-snug">{popis}</span>
  </div>
</figure>
