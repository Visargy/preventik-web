---
import { firma, hlavniMenu, patickaMenu, kategorie, href } from "../lib/site";
const rok = new Date().getFullYear();
---
<footer class="mt-24 border-t-4 border-hasici-500 bg-policie-800 text-policie-100">
  <div class="obal grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-1">
      <span class="font-nadpis text-xl font-extrabold text-white">
        preventik<span class="text-hasici-400">.cz</span>
      </span>
      <p class="mt-3 text-sm leading-relaxed text-policie-200">
        Vzdělávací tiskoviny, hry a reklamní předměty pro preventivní programy
        městské policie a měst. Vyvíjíme, tiskneme a vyrábíme od roku {firma.odRoku}.
      </p>
      <p class="mt-4 text-sm text-policie-200">
        Provozovatel: {firma.provozovatel}<br />
        IČO: {firma.ico} · {firma.adresa}
      </p>
    </div>

    <div>
      <h2 class="font-nadpis text-sm font-bold uppercase tracking-wider text-white">Web</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {hlavniMenu.map((p) => (
          <li><a href={href(p.odkaz)} class="hover:text-white">{p.text}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-nadpis text-sm font-bold uppercase tracking-wider text-white">Kategorie</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {kategorie.map((k) => (
          <li><a href={href(`/produkty/${k.slug}`)} class="hover:text-white">{k.nazev}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-nadpis text-sm font-bold uppercase tracking-wider text-white">Kontakt</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={firma.telefonHref} class="hover:text-white">{firma.telefon}</a></li>
        <li><a href={firma.whatsappHref} class="hover:text-white">WhatsApp</a></li>
        <li><a href={`mailto:${firma.email}`} class="hover:text-white">{firma.email}</a></li>
        <li><a href={href("/poptavka")} class="hover:text-white">Nezávazná poptávka</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-policie-700">
    <div class="obal flex flex-col gap-2 py-5 text-xs text-policie-300 md:flex-row md:items-center md:justify-between">
      <p>© {rok} {firma.provozovatel}. Obsah webu je chráněn autorským právem.</p>
      <ul class="flex flex-wrap gap-4">
        {patickaMenu.map((p) => (
          <li><a href={href(p.odkaz)} class="hover:text-white">{p.text}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
